{
  "name": "tracy-bookstore",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/lib-storage": "^3.1134.0",
    "@cap-js-community/odata-v2-adapter": "^1.16.1",
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER"
      },
      "[production]": {
        "db": {
          "kind": "hana"
        },
        "auth": {
          "kind": "mocked",
          "users": {
            "richard.musime@moyotech.net": {
              "roles": ["Viewer", "Admin", "authenticated-user"]
            },
            "tracy.tesi@moyotech.net": {
              "roles": ["Viewer", "authenticated-user"]
            }
          }
        },
        "API_BUSINESS_PARTNER": {
          "impl": "@sap/cds/srv/app-service.js"
        }
      }
    }
  }
}
