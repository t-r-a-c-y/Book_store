{
  "name": "tracy-bookstore",
  "version": "1.0.0",
  "type": "module",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1134.0",
    "@aws-sdk/lib-storage": "^3.1134.0",
    "@cap-js-community/odata-v2-adapter": "^1.16.1",
    "@cap-js/audit-logging": "^1.3.0",
    "@cap-js/change-tracking": "^2.2.2",
    "@cap-js/hana": "^3",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap-cloud-sdk/resilience": "^4",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.2",
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "jest": "^30.5.2"
  },
  "scripts": {
    "start": "cds-serve",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "watch-bookshop-fiori": "cds watch --open ns.bookshopfiori/index.html?sap-ui-xx-viewCache=false --livereload false",
    "debug": "cds watch --with-mocks"
  },
  "private": true,
  "cds": {
  "requires": {
    "db": {
      "kind": "sqlite",
      "credentials": {
        "url": "db.sqlite"
      }
    },
    "change-tracking": true,
    "audit-logging": {
      "handle": ["READ", "WRITE"],
      "outbox": true
    },
    "API_BUSINESS_PARTNER": {
      "kind": "odata-v2",
      "model": "srv/external/API_BUSINESS_PARTNER"
    },
    "[production]": {
      "auth": "xsuaa",
      "db": {
        "kind": "hana"
      },
      "API_BUSINESS_PARTNER": {
        "kind": "odata-v2",
        "model": "srv/external/API_BUSINESS_PARTNER",
        "credentials": {
          "destination": "API_BUSINESS_PARTNER"
        }
      }
    }
  }
},
  "sapux": [
    "app/bookshop-fiori"
  ],
  "workspaces": [
    "app/*"
  ],
  "allowScripts": {
    "@parcel/watcher@2.6.0": true
  }
}
