{
  "xsappname": "tracy-bookstore",
  "tenant-mode": "dedicated",
  "scopes": [
    {
      "name": "$XSAPPNAME.Viewer",
      "description": "View books"
    },
    {
      "name": "$XSAPPNAME.Admin",
      "description": "Admin access"
    }
  ],
  "role-templates": [
    {
      "name": "Viewer",
      "description": "Can view books",
      "scope-references": [
        "$XSAPPNAME.Viewer"
      ]
    },
    {
      "name": "Admin",
      "description": "Can administer books",
      "scope-references": [
        "$XSAPPNAME.Viewer",
        "$XSAPPNAME.Admin"
      ]
    }
  ]
}