<mvc:View
  controllerName="ns.bookshopfiori.controller.BookCreate"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.ui.layout.form"
  height="100%"
  displayBlock="true">

  <Page id="bookCreatePage" title="{i18n>createBook}" showNavButton="false">

    <customHeader>
      <Bar>
        <contentLeft>
          <Breadcrumbs class="sapUiSmallMarginBegin">
            <Link text="Home" press=".onNavBooks" />
            <Link text="Books" press=".onNavBooks" />
            <Link text="{i18n>createBook}" />
          </Breadcrumbs>
        </contentLeft>
      </Bar>
    </customHeader>

    <content>
      <VBox class="sapUiMediumMargin">
        <f:SimpleForm
          editable="true"
          layout="ResponsiveGridLayout"
          labelSpanL="3"
          labelSpanM="3"
          columnsL="1"
          columnsM="1">

          <f:content>
            <Label text="{i18n>Title}" required="true" />
            <Input
              value="{form>/title}"
              liveChange=".onFieldChange"
              valueState="{form>/titleState}"
              valueStateText="{form>/titleStateText}" />

            <Label text="{i18n>Description}" />
            <TextArea
              value="{form>/description}"
              rows="4"
              liveChange=".onFieldChange"
              valueState="{form>/descriptionState}"
              valueStateText="{form>/descriptionStateText}" />

            <Label text="{i18n>Price}" required="true" />
            <Input
              type="Number"
              value="{form>/price}"
              liveChange=".onFieldChange"
              valueState="{form>/priceState}"
              valueStateText="{form>/priceStateText}" />

            <Label text="{i18n>Stock}" required="true" />
            <Input
              type="Number"
              value="{form>/stock}"
              liveChange=".onFieldChange"
              valueState="{form>/stockState}"
              valueStateText="{form>/stockStateText}" />

            <Label text="{i18n>Author}" required="true" />
            <Select
              forceSelection="false"
              selectedKey="{form>/author_ID}"
              change=".onFieldChange"
              width="100%"
              valueState="{form>/authorState}"
              valueStateText="{form>/authorStateText}"
              items="{
                path: '/Authors',
                sorter: { path: 'name' }
              }">
              <core:Item key="{ID}" text="{name}" />
            </Select>
          </f:content>
        </f:SimpleForm>
      </VBox>
    </content>

    <footer>
      <Toolbar>
        <ToolbarSpacer />
        <Button text="{i18n>Cancel}" press=".onCancel" />
        <Button
          text="{i18n>create}"
          type="Emphasized"
          icon="sap-icon://save"
          press=".onSave" />
      </Toolbar>
    </footer>
  </Page>
</mvc:View>