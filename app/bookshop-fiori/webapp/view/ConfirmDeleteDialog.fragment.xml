<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="confirmDeleteDialog"
    title="Delete Book"
    type="Message"
    state="Warning"
    icon="sap-icon://delete">

    <content>
      <Text
        text="Do you really want to delete the book '{delete>/title}'?"
        class="sapUiSmallMargin" />
    </content>

    <beginButton>
      <Button
        text="Delete"
        type="Reject"
        icon="sap-icon://delete"
        press=".onConfirmDelete" />
    </beginButton>

    <endButton>
      <Button
        text="Cancel"
        press=".onCloseDeleteDialog" />
    </endButton>

  </Dialog>
</core:FragmentDefinition>