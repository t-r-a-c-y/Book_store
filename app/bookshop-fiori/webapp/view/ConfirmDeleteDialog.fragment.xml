<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="confirmDeleteDialog"
    title="{i18n>deleteBook}"
    type="Message"
    state="Warning"
    icon="sap-icon://delete">

    <content>
      <Text
        text="{i18n>deleteBookConfirm} '{delete>/title}'?"
        class="sapUiSmallMargin" />
    </content>

    <beginButton>
      <Button
        text="{i18n>delete}"
        type="Reject"
        icon="sap-icon://delete"
        press=".onConfirmDelete" />
    </beginButton>

    <endButton>
      <Button
        text="{i18n>Cancel}"
        press=".onCloseDeleteDialog" />
    </endButton>

  </Dialog>
</core:FragmentDefinition>