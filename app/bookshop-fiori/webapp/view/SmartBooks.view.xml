<mvc:View
  controllerName="ns.bookshopfiori.controller.SmartBooks"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:smartFilterBar="sap.ui.comp.smartfilterbar"
  xmlns:smartTable="sap.ui.comp.smarttable"
  height="100%"
  displayBlock="true">

  <Page
    id="smartBooksPage"
    title="Smart Books"
    showNavButton="fasle"
    navButtonPress=".onNavBack"
    enableScrolling="false">

    <customHeader>
      <Bar>
        <contentLeft>
          <Breadcrumbs id="smartBooksBreadcrumbs" class="sapUiSmallMarginBegin">
            <Link text="Home" press=".onNavHome" />
            <Link text="Books" press=".onNavBooks" />
            <Link text="Smart Books" />
          </Breadcrumbs>
        </contentLeft>
      </Bar>
    </customHeader>

    <content>
      <VBox height="100%" fitContainer="true" width="100%">

        <smartFilterBar:SmartFilterBar
          id="smartFilterBar"
          entitySet="Books"
          persistencyKey="SmartBooksFilterBar"
          enableBasicSearch="true"
          width="100%" />

        <smartTable:SmartTable
          id="smartBooksTable"
          entitySet="Books"
          smartFilterId="smartFilterBar"
          tableType="Table"
          header="Books"
          showRowCount="true"
          enableAutoBinding="true"
          enableAutoColumnWidth="true"
          fitContainer="true"
          width="100%"
          beforeRebindTable=".onBeforeRebindTable">

          <Table
            growing="true"
            growingThreshold="20"
            sticky="ColumnHeaders,HeaderToolbar"
            width="100%" />

        </smartTable:SmartTable>

      </VBox>
    </content>
  </Page>
</mvc:View>