<mvc:View
  controllerName="ns.bookshopfiori.controller.OrderWizard"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page
    id="orderWizardPage"
    title="Create Order"
    showNavButton="true"
    navButtonPress=".onNavBack">

    <content>
      <Wizard
        id="orderWizard"
        showNextButton="false"
        complete=".onWizardComplete"
        class="sapUiResponsivePadding--header sapUiResponsivePadding--content">

        <!-- STEP 1: Customer -->
        <WizardStep id="stepCustomer" title="Customer" validated="true">
          <MessageStrip
            text="Step 1: Select the customer."
            type="Information"
            showIcon="true"
            class="sapUiSmallMarginBottom" />

          <Label text="Customer" labelFor="customerSelect" />
          <Select
            id="customerSelect"
            forceSelection="false"
            change=".onCustomerChange"
            width="100%"
            items="{
              path: '/Users',
              sorter: { path: 'name' }
            }">
            <core:Item key="{ID}" text="{name}" />
          </Select>
        </WizardStep>

        <!-- STEP 2: Book -->
        <WizardStep id="stepBook" title="Book" validated="true">
          <MessageStrip
            text="Step 2: Select a book and quantity."
            type="Information"
            showIcon="true"
            class="sapUiSmallMarginBottom" />

          <Label text="Book" labelFor="bookSelect" />
          <Select
            id="bookSelect"
            forceSelection="false"
            change=".onBookChange"
            width="100%"
            items="{
              path: '/Books',
              sorter: { path: 'title' }
            }">
            <core:Item key="{ID}" text="{title}" />
          </Select>

          <Label text="Quantity" labelFor="quantityInput" class="sapUiSmallMarginTop" />
          <Input
            id="quantityInput"
            type="Number"
            value="{wizard>/quantity}"
            width="8rem"
            liveChange=".onQuantityChange" />
        </WizardStep>

        <!-- STEP 3: Confirm -->
        <WizardStep id="stepConfirm" title="Confirm" validated="true">
          <MessageStrip
            text="Step 3: Review and finish."
            type="Success"
            showIcon="true"
            class="sapUiSmallMarginBottom" />

          <VBox class="sapUiSmallMargin">
            <HBox class="sapUiTinyMarginBottom">
              <Label text="Customer:" class="sapUiTinyMarginEnd" />
              <Text text="{wizard>/customerName}" />
            </HBox>
            <HBox class="sapUiTinyMarginBottom">
              <Label text="Book:" class="sapUiTinyMarginEnd" />
              <Text text="{wizard>/bookTitle}" />
            </HBox>
            <HBox>
              <Label text="Quantity:" class="sapUiTinyMarginEnd" />
              <Text text="{wizard>/quantity}" />
            </HBox>
          </VBox>
        </WizardStep>
      </Wizard>
    </content>

    <!-- Explicit Back / Next / Finish buttons -->
    <footer>
      <Toolbar>
        <Button
          id="btnWizardBack"
          text="Back"
          icon="sap-icon://navigation-left-arrow"
          press=".onWizardBack"
          enabled="{wizard>/backEnabled}" />
        <ToolbarSpacer />
        <Button
          id="btnWizardNext"
          text="{wizard>/nextText}"
          icon="{wizard>/nextIcon}"
          type="Emphasized"
          press=".onWizardNext" />
      </Toolbar>
    </footer>

  </Page>
</mvc:View>