<mvc:View
    controllerName="ns.bookshopfiori.controller.App"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:f="sap.f"
    displayBlock="true"
    height="100%">

    <!-- The id attribute must say fclContainer to match manifest.json -->
    <f:FlexibleColumnLayout
        id="fclContainer"
        layout="{fcl>/layout}"
        backgroundDesign="Translucent"
        width="100%"
        height="100%" />

</mvc:View>
