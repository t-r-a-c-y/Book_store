<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:u="sap.ui.unified">

  <Dialog
    id="pdfDialog"
    title="{pdf>/title}"
    contentWidth="95%"
    contentHeight="95%"
    stretchOnPhone="true"
    verticalScrolling="false"
    horizontalScrolling="false"
    resizable="true"
    draggable="true">

    <content>
      <VBox width="100%" height="100%" renderType="Bare">

        <!-- Always visible upload row -->
        <HBox
          alignItems="Center"
          class="sapUiSmallMargin"
          width="100%">
          <u:FileUploader
            id="pdfUploader"
            name="pdfFile"
            width="100%"
            fileType="pdf"
            maximumFileSize="15"
            buttonText="Upload PDF"
            buttonOnly="false"
            sameFilenameAllowed="true"
            change=".onPdfFileChange" />
        </HBox>

        <!-- Scrollable PDF area (takes remaining height) -->
        <ScrollContainer
          height="75vh"
          width="100%"
          vertical="true"
          horizontal="true"
          focusable="false">

          <PDFViewer
            id="pdfViewer"
            source="{pdf>/source}"
            title="{pdf>/title}"
            height="80vh"
            width="100%"
            isTrustedSource="true"
            showDownloadButton="true"
            visible="{= ${pdf>/mode} === 'viewer' }" />

          <core:HTML
            id="pdfFrame"
            visible="{= ${pdf>/mode} === 'iframe' }"
            content="{pdf>/iframeHtml}" />

          <Text
            class="sapUiSmallMargin"
            text="Upload a PDF file to preview it here."
            visible="{= !${pdf>/source} }" />

        </ScrollContainer>

      </VBox>
    </content>

    <beginButton>
      <Button
        text="Open in new tab"
        icon="sap-icon://action"
        press=".onPdfOpenTab"
        enabled="{= !!${pdf>/blobUrl} }" />
    </beginButton>

    <endButton>
      <Button text="Close" press=".onClosePdf" icon="sap-icon://decline" />
    </endButton>

  </Dialog>
</core:FragmentDefinition>