<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n>booksPageTitle}">

    <!-- ========== FILTER AREA (important for List Report) ========== -->
   <subHeader>
  <Toolbar>
    <SearchField
      id="searchField"
      width="30%"
      placeholder="Search by title..."
      liveChange=".onSearch" />

    <ToolbarSpacer />

    <Label text="Author:" labelFor="authorFilter" />
    <Select
      id="authorFilter"
      selectedKey="ALL"
      change=".onFilterAuthor"
      width="12rem"
      items="{path: 'authors>/'}">
      <core:Item key="{authors>key}" text="{authors>text}" />
    </Select>

    <Label text="Stock:" labelFor="stockFilter" class="sapUiTinyMarginBegin" />
    <Select
      id="stockFilter"
      selectedKey="ALL"
      change=".onFilterStock"
      width="10rem">
      <core:Item key="ALL" text="All" />
      <core:Item key="IN_STOCK" text="In Stock" />
      <core:Item key="OUT_OF_STOCK" text="Out of Stock" />
    </Select>
  </Toolbar>
</subHeader>

    <!-- ========== ACTIONS ========== -->
    <headerContent>
  <Button
    icon="sap-icon://add"
    text="Create Order"
    press=".onCreateOrder"
    tooltip="Create Order" />
  <Button icon="sap-icon://sort" press=".onSort" tooltip="Sort by Title" />
  <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="Refresh" />
</headerContent>

    <!-- ========== TABLE ========== -->
    <content>
      <Panel
        headerText="{i18n>booksListHeader}"
        class="sapUiResponsiveMargin myBooksPanel">

        <Table
          id="booksTable"
          items="{/Books}"
          mode="None"
          growing="true"
          growingThreshold="20">

          <columns>
            <Column width="35%">
              <Text text="{i18n>columnTitle}" />
            </Column>
            <Column width="25%">
              <Text text="{i18n>columnAuthor}" />
            </Column>
            <Column width="15%" hAlign="End">
              <Text text="{i18n>columnPrice}" />
            </Column>
            <Column width="25%" hAlign="Center">
              <Text text="{i18n>Stock}" />
            </Column>
          </columns>

          <items>
            <ColumnListItem
              type="Navigation"
              press=".onBookPress">
              <cells>
                <ObjectIdentifier title="{title}" />
                <Text text="{author/name}" />
                <ObjectNumber number="{price}" unit="EUR" />
                <ObjectStatus
                  text="{= ${stock} > 0 ? 'In Stock (' + ${stock} + ')' : 'Out of Stock' }"
                  state="{= ${stock} > 0 ? 'Success' : 'Error' }" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </Panel>
    </content>
  </Page>
</mvc:View>