<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">

  <Page 
    id="booksPage"
    title="{i18n>booksPageTitle}"
    titleAlignment="Center"
    class="myPageTitle">

    <headerContent>
      <Button icon="sap-icon://refresh" tooltip="Refresh" press=".onRefresh" />
    </headerContent>

    <content>
      <Panel 
        headerText="{i18n>booksListHeader}"
        expandable="false"
        class="sapUiResponsiveMargin myBooksPanel">

        <List 
          id="booksList"
          items="{/Books}">
          <ObjectListItem
  title="{title}"
  number="{
    path: 'price',
    formatter: '.formatter.price'
  }"
  intro="{author/name}"
  type="Active"
  press=".onBookPress"
  class="myBookListItem">

  <firstStatus>
    <ObjectStatus
      text="{= ${stock} > 0 ? 'In Stock' : 'Out of Stock' }"
      state="{= ${stock} > 0 ? 'Success' : 'Error' }" />
  </firstStatus>

</ObjectListItem>
        </List>
      </Panel>
    </content>

  </Page>
</mvc:View>