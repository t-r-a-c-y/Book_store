<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:f="sap.f"
  xmlns:layout="sap.ui.layout"
  height="100%"
  displayBlock="true">

  <f:DynamicPage
    id="booksDynamicPage"
    fitContent="true"
    toggleHeaderOnTitleClick="true"
    preserveHeaderStateOnScroll="true">

    <f:title>
      <f:DynamicPageTitle>

        <f:heading>
          <Title text="{i18n>booksPageTitle}" level="H2" />
        </f:heading>

        <f:expandedContent>
          <Label text="{i18n>booksListHeader}" />
        </f:expandedContent>

        <f:snappedContent>
          <Label text="{i18n>booksListHeader}" />
        </f:snappedContent>

        <f:actions>
          <Button
            icon="sap-icon://add"
            text="{i18n>createBook}"
            type="Emphasized"
            press=".onCreateBook" />

          <Button
            icon="sap-icon://add-document"
            text="{i18n>createOrder}"
            type="Transparent"
            press=".onCreateOrder" />

          <Button
            id="btnEditSelected"
            icon="sap-icon://edit"
            text="{i18n>edit}"
            type="Transparent"
            enabled="false"
            press=".onEditSelected" />

          <Button
            id="btnDeleteSelected"
            icon="sap-icon://delete"
            text="{i18n>delete}"
            type="Transparent"
            enabled="false"
            press=".onDeleteSelected" />

          <Button
            id="msgButton"
            icon="sap-icon://message-popup"
            text="Messages"
            type="Transparent"
            press=".onMessagePopoverPress" />

          <Button
            text="Smart Books"
            icon="sap-icon://table-view"
            type="Transparent"
            press=".onOpenSmartBooks" />

          <Button
            text="Preview PDF"
            icon="sap-icon://pdf-attachment"
            type="Transparent"
            press=".onOpenPdf" />

          <Button
            icon="sap-icon://refresh"
            tooltip="{i18n>refresh}"
            type="Transparent"
            press=".onRefresh" />
        </f:actions>

      </f:DynamicPageTitle>
    </f:title>

    <f:header>
      <f:DynamicPageHeader pinnable="true">
        <layout:HorizontalLayout allowWrapping="true" class="sapUiSmallMargin">

          <layout:VerticalLayout class="sapUiMediumMarginEnd">
            <Label text="{i18n>searchPlaceholder}" />
            <SearchField
              id="searchField"
              width="20rem"
              liveChange=".onSearch" />
          </layout:VerticalLayout>

          <layout:VerticalLayout class="sapUiMediumMarginEnd">
            <Label text="{i18n>Author}" labelFor="authorFilter" />
            <Select
              id="authorFilter"
              selectedKey="ALL"
              change=".onFilterAuthor"
              width="12rem"
              items="{path: 'authors>/'}">
              <core:Item key="{authors>key}" text="{authors>text}" />
            </Select>
          </layout:VerticalLayout>

          <layout:VerticalLayout>
            <Label text="{i18n>Stock}" labelFor="stockFilter" />
            <Select
              id="stockFilter"
              selectedKey="ALL"
              change=".onFilterStock"
              width="10rem">
              <core:Item key="ALL" text="{i18n>all}" />
              <core:Item key="IN_STOCK" text="{i18n>inStock}" />
              <core:Item key="OUT_OF_STOCK" text="{i18n>outOfStock}" />
            </Select>
          </layout:VerticalLayout>

        </layout:HorizontalLayout>
      </f:DynamicPageHeader>
    </f:header>

    <f:content>
      <Table
        id="booksTable"
        mode="MultiSelect"
        growing="true"
        growingThreshold="20"
        sticky="ColumnHeaders,HeaderToolbar"
        fixedLayout="true"
        selectionChange=".onTableSelectionChange"
        class="sapFDynamicPageAlignContent"
        width="auto"
        items="{
          path: '/Books',
          parameters: {
            $expand: 'author'
          }
        }">

        <headerToolbar>
          <Toolbar>
            <Title text="{i18n>booksListHeader}" level="H2" />
          </Toolbar>
        </headerToolbar>

        <columns>
          <Column width="35%">
            <HBox alignItems="Center">
              <Text text="{i18n>columnTitle}" class="sapUiTinyMarginEnd" />
              <Button
                icon="sap-icon://sort"
                type="Transparent"
                tooltip="{i18n>sort}"
                press=".onSort" />
            </HBox>
          </Column>
          <Column width="30%">
            <Text text="{i18n>columnAuthor}" />
          </Column>
          <Column width="15%" hAlign="End">
            <Text text="{i18n>columnPrice}" />
          </Column>
          <Column width="20%" hAlign="Center">
            <Text text="{i18n>Stock}" />
          </Column>
        </columns>

        <items>
          <ColumnListItem type="Navigation" press=".onBookPress">
            <cells>
              <ObjectIdentifier title="{title}" />
              <Text text="{author/name}" />
              <ObjectNumber number="{price}" unit="EUR" />
              <ObjectStatus
                text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
                state="{ path: 'stock', formatter: '.formatter.stockStatusState' }" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    </f:content>

  </f:DynamicPage>
</mvc:View>