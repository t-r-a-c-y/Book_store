<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n>booksPageTitle}">

    <subHeader>
      <Toolbar>
        <SearchField
          width="100%"
          placeholder="Search by book title..."
          liveChange=".onSearch" />
      </Toolbar>
    </subHeader>

    <headerContent>
      <Button icon="sap-icon://sort" press=".onSort" tooltip="Sort by Title" />
      <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="Refresh" />
    </headerContent>

    <content>
      <Panel
        headerText="{i18n>booksListHeader}"
        class="sapUiResponsiveMargin myBooksPanel">

        <List id="booksList" items="{/Books}">
          <ObjectListItem
            title="{title}"
            number="{price}"
            numberUnit="EUR"
            intro="{author/name}"
            type="Active"
            press=".onBookPress"
            class="myBookListItem">

            <firstStatus>
              <ObjectStatus
                text="{= ${stock} > 0 ? 'In Stock' : 'Out of Stock' }"
                state="{= ${stock} > 0 ? 'Success' : 'Error' }" />
            </firstStatus>

          </ObjectListItem>
        </List>
      </Panel>
    </content>
  </Page>
</mvc:View>