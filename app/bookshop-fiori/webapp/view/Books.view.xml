<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">

  <Page 
    id="booksPage"
    title="{i18n>booksPageTitle}"
    showNavButton="false">

    <!-- Optional header content -->
    <headerContent>
      <Button icon="sap-icon://refresh" tooltip="Refresh" press=".onRefresh" />
    </headerContent>

    <content>
      <!-- Panel gives a nice titled section -->
      <Panel 
        headerText="{i18n>booksListHeader}"
        expandable="false"
        class="sapUiResponsiveMargin">

        <List 
          id="booksList"
          items="{/Books}"
          mode="SingleSelectMaster">
          <ObjectListItem
            title="{title}"
            number="{price}"
            numberUnit="EUR"
            intro="{author/name}"
            type="Active"
            press=".onBookPress" />
        </List>
      </Panel>
    </content>

  </Page>
</mvc:View>