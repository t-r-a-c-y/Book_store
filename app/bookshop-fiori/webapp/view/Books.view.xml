<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n>booksPageTitle}">

    <subHeader>
      <Toolbar>
        <SearchField
          id="searchField"
          width="25%"
          placeholder="{i18n>searchPlaceholder}"
          liveChange=".onSearch" />

        <Label text="{i18n>Author}" labelFor="authorFilter" class="sapUiTinyMarginBegin" />
        <Select
          id="authorFilter"
          selectedKey="ALL"
          change=".onFilterAuthor"
          width="11rem"
          items="{path: 'authors>/'}">
          <core:Item key="{authors>key}" text="{authors>text}" />
        </Select>

        <Label text="{i18n>Stock}" labelFor="stockFilter" class="sapUiTinyMarginBegin" />
        <Select
          id="stockFilter"
          selectedKey="ALL"
          change=".onFilterStock"
          width="9rem">
          <core:Item key="ALL" text="{i18n>all}" />
          <core:Item key="IN_STOCK" text="{i18n>inStock}" />
          <core:Item key="OUT_OF_STOCK" text="{i18n>outOfStock}" />
        </Select>

        <ToolbarSpacer />

        <Button
          icon="sap-icon://add"
          text="{i18n>createBook}"
          press=".onCreateBook"
          type="Emphasized" />

        <Button
          icon="sap-icon://add-document"
          text="{i18n>createOrder}"
          press=".onCreateOrder"
          class="sapUiTinyMarginBegin" />
      </Toolbar>
    </subHeader>

    <headerContent>
      <Button icon="sap-icon://sort" press=".onSort" tooltip="{i18n>sort}" />
      <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="{i18n>refresh}" />
    </headerContent>

    <content>
      <Panel
        headerText="{i18n>booksListHeader}"
        class="sapUiResponsiveMargin myBooksPanel">

        <Table
          id="booksTable"
          mode="None"
          growing="true"
          growingThreshold="20"
          items="{
            path: '/Books',
            parameters: {
              $expand: 'author'
            }
          }">

          <columns>
            <Column width="30%">
              <Text text="{i18n>columnTitle}" />
            </Column>
            <Column width="25%">
              <Text text="{i18n>columnAuthor}" />
            </Column>
            <Column width="15%" hAlign="End">
              <Text text="{i18n>columnPrice}" />
            </Column>
            <Column width="20%" hAlign="Center">
              <Text text="{i18n>Stock}" />
            </Column>
            <Column width="10rem" hAlign="Center">
              <Text text="{i18n>actions}" />
            </Column>
          </columns>

          <items>
            <ColumnListItem type="Navigation" press=".onBookPress">
              <cells>
                <ObjectIdentifier title="{title}" />
                <Text text="{author/name}" />
                <ObjectNumber number="{price}" unit="EUR" />
                <ObjectStatus
                  text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
                  state="{ path: 'stock', formatter: '.formatter.stockStatusState' }" />
                <HBox justifyContent="Center">
                  <Button
                    icon="sap-icon://edit"
                    type="Transparent"
                    tooltip="{i18n>edit}"
                    press=".onEditBook" />
                  <Button
                    icon="sap-icon://delete"
                    type="Transparent"
                    tooltip="{i18n>delete}"
                    press=".onDeleteBook" />
                </HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>
      </Panel>
    </content>
  </Page>
</mvc:View>