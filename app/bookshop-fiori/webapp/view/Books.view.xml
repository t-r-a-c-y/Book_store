<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n>booksPageTitle}">

    <!-- Search -->
    <subHeader>
      <Toolbar>
        <SearchField
          width="100%"
          placeholder="Search by book title..."
          liveChange=".onSearch" />
      </Toolbar>
    </subHeader>

    <!-- Buttons -->
    <headerContent>
      <Button icon="sap-icon://sort" press=".onSort" tooltip="Sort by Title" />
      <Button icon="sap-icon://refresh" press=".onRefresh" tooltip="Refresh" />
    </headerContent>

    <content>
      <Panel
        headerText="{i18n>booksListHeader}"
        class="sapUiResponsiveMargin myBooksPanel">

        <!-- ========== TABLE ========== -->
        <Table
          id="booksTable"
          items="{/Books}"
          mode="None"
          growing="true"
          growingThreshold="20">

          <columns>
            <Column width="40%">
              <Text text="Title" />
            </Column>
            <Column width="25%">
              <Text text="Author" />
            </Column>
            <Column width="15%" hAlign="End">
              <Text text="Price" />
            </Column>
            <Column width="20%" hAlign="Center">
              <Text text="Stock" />
            </Column>
          </columns>

          <items>
            <ColumnListItem
              type="Navigation"
              press=".onBookPress">
              <cells>
                <!-- Title -->
                <ObjectIdentifier title="{title}" />

                <!-- Author -->
                <Text text="{author/name}" />

                <!-- Price -->
                <ObjectNumber
                  number="{price}"
                  unit="EUR" />

                <!-- Stock status -->
                <ObjectStatus
                  text="{= ${stock} > 0 ? 'In Stock (' + ${stock} + ')' : 'Out of Stock' }"
                  state="{= ${stock} > 0 ? 'Success' : 'Error' }" />
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </Panel>
    </content>
  </Page>
</mvc:View>