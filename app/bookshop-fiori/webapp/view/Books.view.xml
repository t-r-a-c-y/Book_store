<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  displayBlock="true">

  <Page title="{i18n>booksPageTitle}">

    <!-- ========== FILTER AREA (important for List Report) ========== -->
  <subHeader>
  <Toolbar>
    <SearchField
      id="searchField"
      width="25%"
      placeholder="Search by title..."
      liveChange=".onSearch" />

    <Label text="Author:" labelFor="authorFilter" class="sapUiTinyMarginBegin" />
    <Select
      id="authorFilter"
      selectedKey="ALL"
      change=".onFilterAuthor"
      width="11rem"
      items="{path: 'authors>/'}">
      <core:Item key="{authors>key}" text="{authors>text}" />
    </Select>

    <Label text="Stock:" labelFor="stockFilter" class="sapUiTinyMarginBegin" />
    <Select
      id="stockFilter"
      selectedKey="ALL"
      change=".onFilterStock"
      width="9rem">
      <core:Item key="ALL" text="All" />
      <core:Item key="IN_STOCK" text="In Stock" />
      <core:Item key="OUT_OF_STOCK" text="Out of Stock" />
    </Select>

    <ToolbarSpacer />

    <Button
      icon="sap-icon://add"
      text="Create Book"
      press=".onCreateBook"
      type="Emphasized" />

    <Button
      icon="sap-icon://add-document"
      text="Create Order"
      press=".onCreateOrder"
      class="sapUiTinyMarginBegin" />
  </Toolbar>
</subHeader>

    <!-- ========== ACTIONS ========== -->
  <headerContent>
  
  <Button icon="sap-icon://sort" press=".onSort" />
  <Button icon="sap-icon://refresh" press=".onRefresh" />
</headerContent>

    <!-- ========== TABLE ========== -->
    <content>
      <Panel
        headerText="{i18n>booksListHeader}"
        class="sapUiResponsiveMargin myBooksPanel">

        <Table
  id="booksTable"
  items="{
    path: '/Books',
    parameters: {
      $expand: 'author'
    }
  }"
  mode="MultiSelect"
  growing="true"
  growingThreshold="20"
  selectionChange=".onTableSelectionChange">

          <columns>
            <Column width="35%">
              <Text text="{i18n>columnTitle}" />
            </Column>
            <Column width="25%">
              <Text text="{i18n>columnAuthor}" />
            </Column>
            <Column width="15%" hAlign="End">
              <Text text="{i18n>columnPrice}" />
            </Column>
            <Column width="25%" hAlign="Center">
              <Text text="{i18n>Stock}" />
            </Column>
            <Column width="10rem" hAlign="Center">
  <Text text="Actions" />
</Column>
          </columns>

          <items>
            <ColumnListItem
              type="Navigation"
              press=".onBookPress">
              <cells>
                <ObjectIdentifier title="{title}" />
                <Text text="{author/name}" />
                <ObjectNumber number="{price}" unit="EUR" />
                <ObjectStatus
  text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
  state="{ path: 'stock', formatter: '.formatter.stockStatusState' }" />
                  <HBox justifyContent="Center">
  <Button
    icon="sap-icon://edit"
    type="Transparent"
    tooltip="Edit"
    press=".onEditBook" />
  <Button
    icon="sap-icon://delete"
    type="Transparent"
    tooltip="Delete"
    press=".onDeleteBook" />
</HBox>
              </cells>
            </ColumnListItem>
          </items>
        </Table>

      </Panel>
    </content>
  </Page>
</mvc:View>