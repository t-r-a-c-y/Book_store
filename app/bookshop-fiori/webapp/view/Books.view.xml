<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true"
  height="100%">

  <Page title="Bookshop - Books (from CAP)" height="100%" enableScrolling="true">
    <content>
      <List id="booksList"
            items="{/Books}"
            headerText="Books from CAP Service"
            class="sapUiSmallMargin">
        <ObjectListItem
          title="{title}"
          number="{price}"
          numberUnit="EUR"
          intro="{author/name}"
          type="Active" />
      </List>
    </content>
  </Page>

</mvc:View>