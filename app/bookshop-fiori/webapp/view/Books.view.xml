<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true">

  <Page 
    id="booksPage"
    title="{i18n>booksPageTitle}"
    titleAlignment="Center"
    class="myPageTitle">

    <headerContent>
      <Button icon="sap-icon://refresh" tooltip="Refresh" press=".onRefresh" />
    </headerContent>

    <content>
      <Panel 
        headerText="{i18n>booksListHeader}"
        expandable="false"
        class="sapUiResponsiveMargin myBooksPanel">

        <List 
          id="booksList"
          items="{/Books}">
          <ObjectListItem
            title="{title}"
            number="{price}"
            numberUnit="EUR"
            intro="{author/name}"
            type="Active"
            press=".onBookPress"
            class="myBookListItem" />
        </List>
      </Panel>
    </content>

  </Page>
</mvc:View>