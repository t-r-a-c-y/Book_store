<mvc:View
  controllerName="ns.bookshopfiori.controller.Books"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  displayBlock="true"
  height="100%">

  <Page title="Bookshop - Books" height="100%" enableScrolling="true">
    <content>
      <List id="booksList"
            items="{books>/Books}"
            headerText="Available Books"
            class="sapUiSmallMargin">
        <ObjectListItem
          title="{books>title}"
          number="{books>price}"
          numberUnit="EUR"
          intro="{books>author/name}"
          type="Active" />
      </List>
    </content>
  </Page>

</mvc:View>