<mvc:View
  controllerName="ns.bookshopfiori.controller.BookDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:uxap="sap.uxap"
  xmlns:custom="ns.bookshopfiori.control"
  xmlns:layout="sap.ui.layout"
  xmlns:u="sap.ui.unified"
  height="100%"
  displayBlock="true">

  <!-- Added useIconTabBar="true" to switch sections into side-by-side tabs -->
  <uxap:ObjectPageLayout
    id="bookObjectPage"
    useIconTabBar="true"
    upperCaseAnchorBar="false"
    showTitleInHeaderContent="true">

    <!-- ================= HEADER TITLE ================= -->
    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>

        <!-- Added Breadcrumbs Trail Element -->
        <uxap:breadcrumbs>
          <Breadcrumbs>
            <Link text="Home" press=".onNavHome" />
            <Link text="Books" press=".onNavBack" />
            <Link text="{title}" />
          </Breadcrumbs>
        </uxap:breadcrumbs>

        <!-- Main Title Zone: Formatted horizontally to show Image -> Title -> Subtitle (Author) -->
        <uxap:heading>
          <HBox alignItems="Center">
            <!-- 1. The Image is displayed first -->
            <Avatar
              id="bookCoverExpanded"
              src="{coverUrl}"
              displaySize="M"
              displayShape="Square"
              fallbackIcon="sap-icon://document-text"
              class="sapUiSmallMarginEnd" />
            
            <!-- 2. Followed by a vertical container housing Title and Subtitle -->
            <VBox>
              <Title text="{title}" level="H2" />
              <Text text="{author/name}" class="sapUiTinyMarginTop sapUiMutedText" />
            </VBox>
          </HBox>
        </uxap:heading>

        <!-- Snapped Heading layout when the page scrolls up -->
        <uxap:snappedHeading>
          <HBox alignItems="Center">
            <Avatar
              id="bookCoverSnapped"
              src="{coverUrl}"
              displaySize="S"
              displayShape="Square"
              fallbackIcon="sap-icon://document-text"
              class="sapUiTinyMarginEnd" />
            <VBox>
              <Title text="{title}" level="H4" />
              <Text text="{author/name}" class="sapUiTinyMarginTop sapUiMutedText" />
            </VBox>
          </HBox>
        </uxap:snappedHeading>

        <!-- Cleared original separate content locations to avoid text redundancy in layout -->
        <uxap:expandedContent />
        <uxap:snappedContent />

        <!-- Actions Toolbar Panel -->
        <uxap:actions>
          <Button
            text="{i18n>edit}"
            icon="sap-icon://edit"
            type="Emphasized"
            press=".onEditBook" />
            
          <Button
            text="{i18n>delete}"
            icon="sap-icon://delete"
            type="Transparent"
            press=".onDeleteBook" />

          <!-- New File Uploader element added directly to the same action toolbar row -->
          <u:FileUploader
            id="coverUploader"
            name="cover"
            fileType="jpg,jpeg,png,gif,webp"
            maximumFileSize="5"
            fileSizeExceed =".onFileSizeExceed"
            buttonOnly="true"
            buttonText="Upload Cover"
            icon="sap-icon://upload"
            style="Transparent"
            change=".onCoverChange" />

          <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            tooltip="Back"
            press=".onNavBack" />
        </uxap:actions>

      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <!-- ================= HEADER CONTENT ================= -->
    <uxap:headerContent>
      <layout:VerticalLayout class="sapUiMediumMarginEnd">
        <ObjectAttribute title="{i18n>Price}" text="{price} EUR" />
        <ObjectAttribute title="{i18n>Stock}" text="{stock}" />
      </layout:VerticalLayout>

      <layout:VerticalLayout class="sapUiMediumMarginEnd">
        <ObjectAttribute title="{i18n>Author}" text="{author/name}" />
        <ObjectStatus
          text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
          state="{ path: 'stock', formatter: '.formatter.stockStatusState' }" />
      </layout:VerticalLayout>

      <layout:VerticalLayout>
        <Label text="Rating" />
        <custom:BookRating
          value="{rating}"
          editable="true"
          change=".onRatingChange" />
      </layout:VerticalLayout>
    </uxap:headerContent>

    <!-- ================= SECTIONS (NOW SWAPPING AS TABS) ================= -->
    <uxap:sections>
      <uxap:ObjectPageSection title="Description" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="About this book">
            <VBox class="sapUiSmallMargin">
              <Text
                text="{= ${description} ? ${description} : 'No description available.' }" />
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <!-- ================= SECTION: Details ================= -->
      <uxap:ObjectPageSection title="Details" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Book information">
            <layout:HorizontalLayout allowWrapping="true" class="sapUiSmallMargin">

              <layout:VerticalLayout class="sapUiLargeMarginEnd">
                <ObjectAttribute title="{i18n>Title}" text="{title}" />
                <ObjectAttribute title="{i18n>Author}" text="{author/name}" />
              </layout:VerticalLayout>

              <layout:VerticalLayout class="sapUiLargeMarginEnd">
                <ObjectAttribute title="{i18n>Price}" text="{price} EUR" />
                <ObjectAttribute title="{i18n>Stock}" text="{stock}" />
              </layout:VerticalLayout>

              <layout:VerticalLayout>
                <ObjectAttribute title="Availability" />
                <ObjectStatus
                  text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
                  state="{ path: 'stock', formatter: '.formatter.stockStatusState' }" />
              </layout:VerticalLayout>

            </layout:HorizontalLayout>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <!-- ================= SECTION: Rating ================= -->
      <uxap:ObjectPageSection title="Rating" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Your rating">
            <VBox class="sapUiSmallMargin">
              <Label text="Click stars to rate this book" class="sapUiTinyMarginBottom" />
              <custom:BookRating
                value="{rating}"
                editable="true"
                change=".onRatingChange" />
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>

  </uxap:ObjectPageLayout>
</mvc:View>
