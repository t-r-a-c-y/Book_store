<mvc:View
  controllerName="ns.bookshopfiori.controller.BookDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:uxap="sap.uxap"
  xmlns:custom="ns.bookshopfiori.control"
  xmlns:layout="sap.ui.layout"
  xmlns:u="sap.ui.unified"
  height="100%"
  displayBlock="true">

  <uxap:ObjectPageLayout
    id="bookObjectPage"
    useIconTabBar="true"
    upperCaseAnchorBar="false"
    showTitleInHeaderContent="true">

    <uxap:headerTitle>
      <uxap:ObjectPageDynamicHeaderTitle>

        <uxap:breadcrumbs>
          <Breadcrumbs>
            <Link text="Home" press=".onNavHome" />
            <Link text="Books" press=".onNavBack" />
            <Link text="{title}" />
          </Breadcrumbs>
        </uxap:breadcrumbs>

        <uxap:heading>
          <HBox alignItems="Center">
            <Avatar
              id="bookCoverExpanded"
              src="{coverUrl}"
              displaySize="M"
              displayShape="Square"
              fallbackIcon="sap-icon://document-text"
              class="sapUiSmallMarginEnd" />
            <VBox>
              <!-- VIEW -->
              <Title text="{title}" level="H2" visible="{= !${ui>/editMode} }" />
              <!-- EDIT -->
              <Input
                value="{title}"
                visible="{= ${ui>/editMode} }"
                valueState="{ui>/titleState}"
                valueStateText="{ui>/titleStateText}"
                width="20rem" />
              <Text text="{author/name}" class="sapUiTinyMarginTop sapUiMutedText" visible="{= !${ui>/editMode} }" />
            </VBox>
          </HBox>
        </uxap:heading>

        <uxap:snappedHeading>
          <HBox alignItems="Center">
            <Avatar
              id="bookCoverSnapped"
              src="{coverUrl}"
              displaySize="S"
              displayShape="Square"
              fallbackIcon="sap-icon://document-text"
              class="sapUiTinyMarginEnd" />
            <VBox>
              <Title text="{title}" level="H4" />
              <Text text="{author/name}" class="sapUiTinyMarginTop sapUiMutedText" />
            </VBox>
          </HBox>
        </uxap:snappedHeading>

        <uxap:expandedContent />
        <uxap:snappedContent />

        <uxap:actions>
          <!-- VIEW -->
          <Button
            text="{i18n>edit}"
            icon="sap-icon://edit"
            type="Emphasized"
            press=".onEditBook"
            visible="{= !${ui>/editMode} }" />
          <Button
            text="{i18n>delete}"
            icon="sap-icon://delete"
            type="Transparent"
            press=".onDeleteBook"
            visible="{= !${ui>/editMode} }" />

          <!-- EDIT -->
          <Button
            text="{i18n>save}"
            icon="sap-icon://save"
            type="Emphasized"
            press=".onSaveEdit"
            visible="{= ${ui>/editMode} }" />
          <Button
            text="{i18n>Cancel}"
            type="Transparent"
            press=".onCancelEdit"
            visible="{= ${ui>/editMode} }" />

          <u:FileUploader
            id="coverUploader"
            name="cover"
            fileType="jpg,jpeg,png,gif,webp"
            maximumFileSize="5"
            fileSizeExceed=".onFileSizeExceed"
            buttonOnly="true"
            buttonText="Upload Cover"
            icon="sap-icon://upload"
            style="Transparent"
            change=".onCoverChange"
            visible="{= !${ui>/editMode} }" />

          <Button
            icon="sap-icon://nav-back"
            type="Transparent"
            tooltip="Back"
            press=".onNavBack"
            visible="{= !${ui>/editMode} }" />
        </uxap:actions>

      </uxap:ObjectPageDynamicHeaderTitle>
    </uxap:headerTitle>

    <uxap:headerContent>
      <layout:VerticalLayout class="sapUiMediumMarginEnd">
        <ObjectAttribute title="{i18n>Price}" text="{price} EUR" visible="{= !${ui>/editMode} }" />
        <Label text="{i18n>Price}" visible="{= ${ui>/editMode} }" />
        <Input
          type="Number"
          value="{price}"
          visible="{= ${ui>/editMode} }"
          valueState="{ui>/priceState}"
          valueStateText="{ui>/priceStateText}"
          width="8rem" />

        <ObjectAttribute title="{i18n>Stock}" text="{stock}" visible="{= !${ui>/editMode} }" />
        <Label text="{i18n>Stock}" visible="{= ${ui>/editMode} }" class="sapUiTinyMarginTop" />
        <Input
          type="Number"
          value="{stock}"
          visible="{= ${ui>/editMode} }"
          valueState="{ui>/stockState}"
          valueStateText="{ui>/stockStateText}"
          width="8rem" />
      </layout:VerticalLayout>

      <layout:VerticalLayout class="sapUiMediumMarginEnd">
        <ObjectAttribute title="{i18n>Author}" text="{author/name}" visible="{= !${ui>/editMode} }" />
        <Label text="{i18n>Author}" visible="{= ${ui>/editMode} }" />
        <Select
          forceSelection="false"
          selectedKey="{author_ID}"
          visible="{= ${ui>/editMode} }"
          valueState="{ui>/authorState}"
          valueStateText="{ui>/authorStateText}"
          width="12rem"
          items="{
            path: '/Authors',
            sorter: { path: 'name' }
          }">
          <core:Item key="{ID}" text="{name}" />
        </Select>

        <ObjectStatus
          text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
          state="{ path: 'stock', formatter: '.formatter.stockStatusState' }"
          visible="{= !${ui>/editMode} }" />
      </layout:VerticalLayout>

      <layout:VerticalLayout>
        <Label text="Rating" />
        <custom:BookRating
          value="{rating}"
          editable="true"
          change=".onRatingChange" />
      </layout:VerticalLayout>
    </uxap:headerContent>

    <uxap:sections>
      <uxap:ObjectPageSection title="Description" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="About this book">
            <VBox class="sapUiSmallMargin">
              <Text
                text="{= ${description} ? ${description} : 'No description available.' }"
                visible="{= !${ui>/editMode} }" />
              <TextArea
                value="{description}"
                rows="5"
                width="100%"
                visible="{= ${ui>/editMode} }"
                valueState="{ui>/descriptionState}"
                valueStateText="{ui>/descriptionStateText}" />
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="Details" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Book information">
            <layout:HorizontalLayout allowWrapping="true" class="sapUiSmallMargin">
              <layout:VerticalLayout class="sapUiLargeMarginEnd">
                <ObjectAttribute title="{i18n>Title}" text="{title}" />
                <ObjectAttribute title="{i18n>Author}" text="{author/name}" />
              </layout:VerticalLayout>
              <layout:VerticalLayout class="sapUiLargeMarginEnd">
                <ObjectAttribute title="{i18n>Price}" text="{price} EUR" />
                <ObjectAttribute title="{i18n>Stock}" text="{stock}" />
              </layout:VerticalLayout>
              <layout:VerticalLayout>
                <ObjectAttribute title="Availability" />
                <ObjectStatus
                  text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
                  state="{ path: 'stock', formatter: '.formatter.stockStatusState' }" />
              </layout:VerticalLayout>
            </layout:HorizontalLayout>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>

      <uxap:ObjectPageSection title="Rating" titleUppercase="false">
        <uxap:subSections>
          <uxap:ObjectPageSubSection title="Your rating">
            <VBox class="sapUiSmallMargin">
              <Label text="Click stars to rate this book" class="sapUiTinyMarginBottom" />
              <custom:BookRating
                value="{rating}"
                editable="true"
                change=".onRatingChange" />
            </VBox>
          </uxap:ObjectPageSubSection>
        </uxap:subSections>
      </uxap:ObjectPageSection>
    </uxap:sections>

  </uxap:ObjectPageLayout>
</mvc:View>