<mvc:View
  controllerName="ns.bookshopfiori.controller.BookDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:custom="ns.bookshopfiori.control"
  displayBlock="true">

  <Page
    id="bookDetailPage"
    title="{title}"
    showNavButton="true"
    navButtonPress=".onNavBack"
    class="sapUiResponsiveContentPadding">

    <headerContent>
      <Button
        icon="sap-icon://edit"
        text="{i18n>edit}"
        type="Emphasized"
        press=".onEditBook" />
      <Button
        icon="sap-icon://delete"
        text="{i18n>delete}"
        type="Reject"
        press=".onDeleteBook" />
    </headerContent>

    <content>

      <ObjectHeader
        title="{title}"
        number="{price}"
        numberUnit="EUR"
        backgroundDesign="Solid"
        class="sapUiSmallMarginBottom">

        <attributes>
          <ObjectAttribute title="{i18n>Author}" text="{author/name}" />
          <ObjectAttribute title="{i18n>Stock}" text="{stock}" />
        </attributes>

        <statuses>
          <ObjectStatus
            text="{ path: 'stock', formatter: '.formatter.stockStatusText' }"
            state="{ path: 'stock', formatter: '.formatter.stockStatusState' }" />
        </statuses>
      </ObjectHeader>

      <Panel headerText="{i18n>Description}" class="sapUiSmallMarginBottom">
        <content>
          <Text
            text="{= ${description} ? ${description} : 'No description available.' }"
            class="sapUiSmallMargin" />
        </content>
      </Panel>

      <Panel headerText="Additional Information" class="sapUiSmallMarginBottom">
        <content>
          <VBox class="sapUiSmallMargin">

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://course-book" class="sapUiTinyMarginEnd" />
              <Label text="{i18n>Title}" class="sapUiTinyMarginEnd" />
              <Text text="{title}" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://money-bills" class="sapUiTinyMarginEnd" />
              <Label text="{i18n>Price}" class="sapUiTinyMarginEnd" />
              <Text text="{price} EUR" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://person-placeholder" class="sapUiTinyMarginEnd" />
              <Label text="{i18n>Author}" class="sapUiTinyMarginEnd" />
              <Text text="{author/name}" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://favorite" class="sapUiTinyMarginEnd" />
              <Label text="Rating" class="sapUiTinyMarginEnd" />
              <custom:BookRating
                value="0"
                editable="true"
                change=".onRatingChange" />
            </HBox>

            <HBox alignItems="Center">
              <core:Icon src="sap-icon://product" class="sapUiTinyMarginEnd" />
              <Label text="{i18n>Stock}" class="sapUiTinyMarginEnd" />
              <Text text="{stock}" />
            </HBox>

          </VBox>
        </content>
      </Panel>

    </content>
  </Page>
</mvc:View>