<mvc:View
  controllerName="ns.bookshopfiori.controller.BookDetail"
  xmlns:mvc="sap.ui.core.mvc"
  xmlns="sap.m"
  xmlns:core="sap.ui.core"
  xmlns:custom="ns.bookshopfiori.control"
  displayBlock="true">

  <Page
    id="bookDetailPage"
    title="{title}"
    showNavButton="true"
    navButtonPress=".onNavBack"
    class="sapUiResponsiveContentPadding">

    <content>

      <!-- ========== OBJECT HEADER ========== -->
      <ObjectHeader
        title="{title}"
        number="{price}"
        numberUnit="EUR"
        backgroundDesign="Solid"
        class="sapUiSmallMarginBottom">

        <attributes>
          <ObjectAttribute title="Author" text="{author/name}" />
          <ObjectAttribute title="Stock" text="{stock} pieces" />
        </attributes>

        <statuses>
          <ObjectStatus
            text="{= ${stock} > 0 ? 'In Stock' : 'Out of Stock' }"
            state="{= ${stock} > 0 ? 'Success' : 'Error' }"
            icon="{= ${stock} > 0 ? 'sap-icon://accept' : 'sap-icon://error' }" />
        </statuses>
      </ObjectHeader>

      <!-- ========== SECTION 1: Description ========== -->
      <Panel
        headerText="Description"
        expandable="false"
        class="sapUiSmallMarginBottom">
        <content>
          <Text
            text="{= ${description} ? ${description} : 'No description available.' }"
            class="sapUiSmallMargin" />
        </content>
      </Panel>

      <!-- ========== SECTION 2: Additional Information ========== -->
      <Panel
        headerText="Additional Information"
        expandable="false"
        class="sapUiSmallMarginBottom">
        <content>
          <VBox class="sapUiSmallMargin">

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://course-book" class="sapUiTinyMarginEnd" />
              <Label text="Title:" class="sapUiTinyMarginEnd" />
              <Text text="{title}" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://money-bills" class="sapUiTinyMarginEnd" />
              <Label text="Price:" class="sapUiTinyMarginEnd" />
              <Text text="{price} EUR" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://person-placeholder" class="sapUiTinyMarginEnd" />
              <Label text="Author:" class="sapUiTinyMarginEnd" />
              <Text text="{author/name}" />
            </HBox>

            <HBox alignItems="Center" class="sapUiTinyMarginBottom">
              <core:Icon src="sap-icon://favorite" class="sapUiTinyMarginEnd" />
              <Label text="Rating:" class="sapUiTinyMarginEnd" />
              <custom:BookRating value="4" />
            </HBox>

            <HBox alignItems="Center">
              <core:Icon src="sap-icon://product" class="sapUiTinyMarginEnd" />
              <Label text="Stock:" class="sapUiTinyMarginEnd" />
              <Text text="{stock}" />
            </HBox>

          </VBox>
        </content>
      </Panel>

    </content>
  </Page>
</mvc:View>