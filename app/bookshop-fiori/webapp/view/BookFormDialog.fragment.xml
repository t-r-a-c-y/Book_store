<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <Dialog
    id="bookFormDialog"
    title="{form>/dialogTitle}"
    icon="sap-icon://course-book"
    class="sapUiResponsiveContentPadding">

    <content>
      <VBox class="sapUiSmallMargin">

        <!-- TITLE (required text) -->
        <Label text="{i18n>Title}" labelFor="inTitle" required="true" />
        <Input
          id="inTitle"
          value="{form>/title}"
          valueState="{form>/titleState}"
          valueStateText="{form>/titleStateText}"
          liveChange=".onBookFieldChange"
          width="100%"
          placeholder="{i18n>titlePlaceholder}" />

        <!-- DESCRIPTION -->
        <Label text="{i18n>Description}" labelFor="inDescription" class="sapUiSmallMarginTop" />
        <TextArea
          id="inDescription"
          value="{form>/description}"
          valueState="{form>/descriptionState}"
          valueStateText="{form>/descriptionStateText}"
          liveChange=".onBookFieldChange"
          rows="3"
          width="100%"
          placeholder="{i18n>descriptionPlaceholder}" />

        <!-- PRICE (required number) -->
        <Label text="{i18n>Price}" labelFor="inPrice" class="sapUiSmallMarginTop" required="true" />
        <Input
          id="inPrice"
          type="Number"
          value="{form>/price}"
          valueState="{form>/priceState}"
          valueStateText="{form>/priceStateText}"
          liveChange=".onBookFieldChange"
          width="100%"
          placeholder="0.00" />

        <!-- STOCK (required integer) -->
        <Label text="{i18n>Stock}" labelFor="inStock" class="sapUiSmallMarginTop" required="true" />
        <Input
          id="inStock"
          type="Number"
          value="{form>/stock}"
          valueState="{form>/stockState}"
          valueStateText="{form>/stockStateText}"
          liveChange=".onBookFieldChange"
          width="100%"
          placeholder="0" />

        <!-- AUTHOR (required select) -->
        <Label text="{i18n>Author}" labelFor="inAuthor" class="sapUiSmallMarginTop" required="true" />
        <Select
          id="inAuthor"
          forceSelection="false"
          selectedKey="{form>/author_ID}"
          valueState="{form>/authorState}"
          valueStateText="{form>/authorStateText}"
          change=".onBookFieldChange"
          width="100%"
          items="{
            path: '/Authors',
            sorter: { path: 'name' }
          }">
          <core:Item key="{ID}" text="{name}" />
        </Select>

      </VBox>
    </content>

    <beginButton>
      <Button
        text="{form>/confirmText}"
        type="Emphasized"
        icon="sap-icon://save"
        press=".onSaveBook" />
    </beginButton>

    <endButton>
      <Button
        text="{i18n>Cancel}"
        icon="sap-icon://decline"
        press=".onCloseBookForm" />
    </endButton>

  </Dialog>
</core:FragmentDefinition>