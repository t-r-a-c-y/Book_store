<mvc:View
    controllerName="floorplans.controller.Worklist"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page
        title="Worklist"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>

            <VBox class="sapUiSmallMargin">

                <MessageStrip
                    text="These books require your attention because their stock is low."
                    type="Warning"
                    showIcon="true" />

                <List
                    headerText="Items Requiring Attention"
                    items="{/lowStockBooks}"
                    class="sapUiSmallMarginTop">

                    <StandardListItem
                        title="{title}"
                        description="Low stock"
                        info="{stock}"
                        infoState="Warning" />

                </List>

            </VBox>

        </content>

    </Page>

</mvc:View>