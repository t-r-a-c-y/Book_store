<mvc:View
    controllerName="floorplans.controller.BookDetail"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:uxap="sap.uxap">

    <Page
        title="Book Details"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>

            <uxap:ObjectPageLayout>

                <uxap:headerTitle>

                    <uxap:ObjectPageDynamicHeaderTitle>

                        <uxap:expandedHeading>

                            <Title
                                text="{title}"
                                level="H1" />

                        </uxap:expandedHeading>

                        <uxap:snappedHeading>

                            <Title
                                text="{title}"
                                level="H2" />

                        </uxap:snappedHeading>

                    </uxap:ObjectPageDynamicHeaderTitle>

                </uxap:headerTitle>

                <uxap:sections>

                    <uxap:ObjectPageSection
                        title="General Information">

                        <uxap:subSections>

                            <uxap:ObjectPageSubSection>

                                <VBox class="sapUiSmallMargin">

                                    <Label text="Title" />

                                    <Text
                                        text="{title}"
                                        class="sapUiTinyMarginBottom" />

                                    <Label text="Price" />

                                    <ObjectNumber
                                        number="{price}"
                                        unit="USD"
                                        class="sapUiTinyMarginBottom" />

                                    <Label text="Stock" />

                                    <ObjectNumber
                                        number="{stock}"
                                        class="sapUiTinyMarginBottom" />

                                </VBox>

                            </uxap:ObjectPageSubSection>

                        </uxap:subSections>

                    </uxap:ObjectPageSection>

                    <uxap:ObjectPageSection
                        title="Description">

                        <uxap:subSections>

                            <uxap:ObjectPageSubSection>

                                <Text
                                    text="{description}"
                                    class="sapUiSmallMargin" />

                            </uxap:ObjectPageSubSection>

                        </uxap:subSections>

                    </uxap:ObjectPageSection>

                </uxap:sections>

            </uxap:ObjectPageLayout>

        </content>

    </Page>

</mvc:View>