<mvc:View
    controllerName="floorplans.controller.Wizard"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Page
        title="Order Wizard"
        showNavButton="true"
        navButtonPress=".onBack">

        <content>

            <Wizard
                id="orderWizard"
                complete=".onComplete">

                <WizardStep
                    id="bookStep"
                    title="Choose Book"
                    validated="true">

                    <VBox class="sapUiSmallMargin">

                        <Title
                            text="Choose your book"
                            level="H3" />

                        <Select
                            id="bookSelect"
                            width="100%">

                            <items>

                                <core:Item
                                    key="1"
                                    text="Clean Code" />

                                <core:Item
                                    key="2"
                                    text="Design Patterns" />

                                <core:Item
                                    key="3"
                                    text="The Pragmatic Programmer" />

                            </items>

                        </Select>

                    </VBox>

                </WizardStep>

                <WizardStep
                    id="customerStep"
                    title="Customer Information">

                    <VBox class="sapUiSmallMargin">

                        <Input
                            placeholder="Your name"
                            id="customerName" />

                        <Input
                            placeholder="Email"
                            type="Email"
                            id="customerEmail"
                            class="sapUiSmallMarginTop" />

                    </VBox>

                </WizardStep>

                <WizardStep
                    id="confirmStep"
                    title="Confirm">

                    <VBox class="sapUiSmallMargin">

                        <Title
                            text="Confirm your order"
                            level="H3" />

                        <Text
                            text="Review your information before completing the order." />

                    </VBox>

                </WizardStep>

            </Wizard>

        </content>

    </Page>

</mvc:View>