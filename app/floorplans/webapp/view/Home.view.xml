<mvc:View
    controllerName="floorplans.controller.Home"
    displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">

    <Page title="Fiori Floor Plans">

        <content>

            <VBox class="sapUiMediumMargin">

                <Title
                    text="Fiori Floor Plans"
                    level="H1" />

                <Text
                    text="Explore different Fiori application patterns."
                    class="sapUiSmallMarginTop" />

                <Button
                    text="Open Books - List Report"
                    type="Emphasized"
                    press=".onOpenBooks"
                    class="sapUiSmallMarginTop" />

                <Button
                    text="Open Worklist"
                    press=".onOpenWorklist"
                    class="sapUiSmallMarginTop" />

                <Button
                    text="Open Wizard"
                    press=".onOpenWizard"
                    class="sapUiSmallMarginTop" />

                <Button
                    text="Open Overview"
                    press=".onOpenOverview"
                    class="sapUiSmallMarginTop" />

            </VBox>

        </content>

    </Page>

</mvc:View>