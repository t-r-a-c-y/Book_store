{
    "_version": "1.65.0",

    "sap.app": {
        "id": "floorplans",
        "type": "application",
        "title": "Fiori Floor Plans"
    },

    "sap.ui": {
        "technology": "UI5"
    },

    "sap.ui5": {
        "rootView": {
            "viewName": "floorplans.view.App",
            "type": "XML",
            "async": true,
            "id": "root"
        },

        "dependencies": {
            "minUI5Version": "1.120.0",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.uxap": {},
                "sap.ui.layout": {}
            }
        },

        "models": {
            "": {
                "type": "sap.ui.model.json.JSONModel"
            }
        },

        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "viewPath": "floorplans.view",
                "controlId": "app",
                "controlAggregation": "pages",
                "async": true
            },

            "routes": [
                {
                    "pattern": "",
                    "name": "home",
                    "target": "home"
                },
                {
                    "pattern": "books",
                    "name": "books",
                    "target": "books"
                },
                {
                    "pattern": "books/{bookId}",
                    "name": "bookDetail",
                    "target": "bookDetail"
                },
                {
                    "pattern": "worklist",
                    "name": "worklist",
                    "target": "worklist"
                },
                {
                    "pattern": "wizard",
                    "name": "wizard",
                    "target": "wizard"
                },
                {
                    "pattern": "overview",
                    "name": "overview",
                    "target": "overview"
                }
            ],

            "targets": {
                "home": {
                    "viewName": "Home"
                },
                "books": {
                    "viewName": "Books"
                },
                "bookDetail": {
                    "viewName": "BookDetail"
                },
                "worklist": {
                    "viewName": "Worklist"
                },
                "wizard": {
                    "viewName": "Wizard"
                },
                "overview": {
                    "viewName": "Overview"
                }
            }
        }
    }
}